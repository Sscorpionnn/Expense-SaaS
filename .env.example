# ------------------------------------------------------------------
# Copy this file to .env and fill in real values for LOCAL DEVELOPMENT
# ONLY. Never commit .env. Use only synthetic/demo values in dev.
# ------------------------------------------------------------------

NODE_ENV=development

# ---- App URLs ----
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Same value as API_URL, exposed to the browser bundle for client-side fetches.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Postgres ----
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=expense_saas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/expense_saas?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_EXPORTS=expense-saas-exports
S3_BUCKET_IMPORTS=expense-saas-imports

# ---- Maildev (dev-only SMTP catcher) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Expense SaaS <no-reply@expense-saas.local>"
MAILDEV_WEB_PORT=1080

# ---- Auth / sessions ----
# Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
SESSION_TTL_HOURS=720
# Optional — only set in production when web and api are on different
# subdomains of the same parent (e.g. ".example.com"), so cookies attach to
# both. Leave commented out for local dev.
# COOKIE_DOMAIN=.example.com

# ---- Rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
